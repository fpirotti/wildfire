message <- local({
old_message <- base::message
function(...) {
txt <- paste0(...)
txt <- paste0(
format(Sys.time(), "[%Y-%m-%d %H:%M:%S] "),
txt
)
old_message(txt)
cat(txt, "\n", file = log_file, append = TRUE)
}
})
