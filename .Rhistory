extractOnly <- function(ids, path){
r <- terra::rast(path[[1]])
xy <- xy4326[ids,]
pts <- sf::sf_project(
from = st_crs(4326)$wkt,
to   = st_crs(r)$wkt,
pts  = xy
)
dt <- terra::extract(r, pts)
chm <- terra::extract(path.CHM$rast.values, xy)[[2]]
chm[is.na(chm)] <- 0
dt$treeHeight.values <-chm
dt
}
extractOnly <- function(ids, path){
r <- terra::rast(path[[1]])
xy <- xy4326[ids,]
pts <- sf::sf_project(
from = st_crs(4326)$wkt,
to   = st_crs(r)$wkt,
pts  = xy
)
dt <- terra::extract(r, pts)
dt
}
